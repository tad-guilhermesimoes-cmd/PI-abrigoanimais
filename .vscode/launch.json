{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AmparaPet: API (depurar)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
