{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AmparaPet: iniciar banco",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\banco.ps1", "iniciar"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "AmparaPet: parar tudo (API + banco)",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/c", "${workspaceFolder}\\parar.bat"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "AmparaPet: iniciar tudo (igual ao iniciar.bat)",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/c", "${workspaceFolder}\\iniciar.bat"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "AmparaPet: rodar testes",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/c", "${workspaceFolder}\\testar.bat"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
