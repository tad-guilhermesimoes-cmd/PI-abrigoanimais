# Copie para .env e ajuste. Em produção, troque TODAS as senhas.

# Banco MySQL (o portátil da pasta mysql/ roda na porta 3307)
DATABASE_URL=mysql+pymysql://amparapet:amparapet@127.0.0.1:3307/amparapet?charset=utf8mb4
# Banco usado pelos testes automatizados (é apagado e recriado a cada execução)
DATABASE_URL_TESTE=mysql+pymysql://amparapet:amparapet@127.0.0.1:3307/amparapet_teste?charset=utf8mb4

# Origens do front-end liberadas no CORS, separadas por vírgula ("*" = todas)
CORS_ORIGENS=*

# Administrador criado automaticamente quando o banco está vazio
ADMIN_INICIAL_NOME=Administrador
ADMIN_INICIAL_EMAIL=admin@amparapet.local
ADMIN_INICIAL_SENHA=trocar123

SESSAO_HORAS=8
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# 1 = serve a interface de teste em /teste (use 0 em produção)
SERVIR_INTERFACE_TESTE=1
